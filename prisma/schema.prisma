generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  USER
  MODERATOR
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum ProfileVoteValue {
  LIKE
  DISLIKE
}

enum ProfileReportReason {
  TOXIC_BEHAVIOR
  HARASSMENT
  CHEATING
  SPAM
  FAKE_PROFILE
  OTHER
}

enum ProfileReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// 1. KULLANICI TABLOSU
model User {
  id        String    @id // Clerk ID
  email     String?
  username  String?
  firstName String?
  lastName  String?
  imageUrl  String?
  staffRole StaffRole @default(USER)

  // Puan Sistemi
  currentPoints Int @default(0)
  totalEarned   Int @default(0)
   
  // ⚡ Günlük Ödül (Streak) Sistemi
  streak        Int       @default(0) // Kaç gün üst üste aldı?
  lastClaimDate DateTime?             // En son ne zaman ödül aldı?

  // 🎮 Gamer Pasaportu (Profil Bilgileri)
  bio           String?   @db.Text                   // Kullanıcı biyografisi
  mainRole      String    @default("UNSELECTED")     // TOP, JUNGLE, MID, ADC, SUPP
  favoriteChamp String    @default("None")           // Favori şampiyon
  rankGoal      String    @default("Challenger")     // Hedef lig
  socialDiscord String?                              // Discord adı

  // 🛍️ YENİ EKLENEN: Market ve Envanter Sistemi
  selectedFrame String    @default("BASIC")          // Şu an takılı olan çerçeve
  ownedFrames   String[]  @default(["BASIC"])        // Satın aldığı çerçeveler listesi (Array)

  // Durum
  isBanned      Boolean  @default(false)
  lastLoginDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // İLİŞKİLER
  comments         Comment[]
  transactions     PointTransaction[]
  notifications    Notification[]
  teamPosts        TeamPost[]
  teamApplications TeamApplication[] @relation("TeamApplicant")
  teamChatMessages TeamChatMessage[]
  sentFriendRequests     FriendRequest[]     @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]     @relation("FriendRequestRecipient")
  friendshipsAsUserA     Friendship[]        @relation("FriendshipUserA")
  friendshipsAsUserB     Friendship[]        @relation("FriendshipUserB")
  profileVotesGiven      ProfileVote[]       @relation("ProfileVoteVoter")
  profileVotesReceived   ProfileVote[]       @relation("ProfileVoteTarget")
  profileReportsSent     ProfileReport[]     @relation("ProfileReportReporter")
  profileReportsReceived ProfileReport[]     @relation("ProfileReportTarget")
  profileReportsReviewed ProfileReport[]     @relation("ProfileReportReviewer")
  globalChatMessages     GlobalChatMessage[]
  adminActionsPerformed AdminActionLog[] @relation("AdminActor")
  adminActionsTargeted  AdminActionLog[] @relation("AdminTarget")
}

// 2. YORUM TABLOSU
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
   
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  guideId   String
  isApproved Boolean @default(false)
}

// 3. PUAN GEÇMİŞİ
model PointTransaction {
  id          String   @id @default(cuid())
  amount      Int
  type        String   // Örnek: "DAILY_REWARD", "GUIDE_READ", "MARKET_PURCHASE"
  description String?
   
  userId      String
  user        User     @relation(fields: [userId], references: [id])
   
  createdAt   DateTime @default(now())
}

// 4. BİLDİRİMLER
model Notification {
  id        String   @id @default(cuid())
  title     String   
  message   String   
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, GIFT
  isRead    Boolean  @default(false)
   
  userId    String
  user      User     @relation(fields: [userId], references: [id])
   
  createdAt DateTime @default(now())
}

model TeamPost {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  rolesNeeded String[]
  rankRange   String   @default("Any")
  server      String   @default("TR")
  maxPlayers  Int      @default(5)
  isActive    Boolean  @default(true)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications TeamApplication[]
  chatMessages TeamChatMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, createdAt])
  @@index([userId, isActive])
}

model TeamApplication {
  id            String   @id @default(cuid())
  teamPostId    String
  teamPost      TeamPost @relation(fields: [teamPostId], references: [id], onDelete: Cascade)

  applicantId   String
  applicant     User     @relation("TeamApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  desiredRole   String
  playerInfo    String
  discord       String
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamPostId, applicantId])
  @@index([teamPostId, status])
  @@index([applicantId, status])
}

model TeamChatMessage {
  id         String   @id @default(cuid())
  teamPostId String
  senderId   String
  content    String
  createdAt  DateTime @default(now())

  teamPost   TeamPost @relation(fields: [teamPostId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teamPostId, createdAt])
  @@index([senderId, createdAt])
}

model FriendRequest {
  id          String            @id @default(cuid())
  senderId    String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  sender      User              @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User              @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
}

model GlobalChatMessage {
  id        String   @id @default(cuid())
  senderId  String
  content   String
  createdAt DateTime @default(now())

  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId, createdAt])
}

model ProfileVote {
  id           String           @id @default(cuid())
  voterId      String
  targetUserId String
  value        ProfileVoteValue
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  voter        User             @relation("ProfileVoteVoter", fields: [voterId], references: [id], onDelete: Cascade)
  targetUser   User             @relation("ProfileVoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetUserId])
  @@index([targetUserId, value])
  @@index([voterId, createdAt])
}

model ProfileReport {
  id           String              @id @default(cuid())
  reporterId   String
  targetUserId String
  reason       ProfileReportReason
  details      String              @db.Text
  status       ProfileReportStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  reviewedById String?
  reviewedAt   DateTime?

  reporter     User                @relation("ProfileReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User                @relation("ProfileReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("ProfileReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetUserId, status, createdAt])
  @@index([reporterId, status, createdAt])
}

model AdminActionLog {
  id              String   @id @default(cuid())
  actorId         String
  actorRole       String
  action          String
  targetUserId    String?
  targetCommentId String?
  details         Json?
  createdAt       DateTime @default(now())

  actor           User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser      User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}
